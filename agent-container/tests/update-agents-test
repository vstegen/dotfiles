#!/usr/bin/env bash
set -euo pipefail

CONTAINER_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
TMP_DIR=$(mktemp -d)
trap 'rm -rf "${TMP_DIR}"' EXIT
mkdir -p "${TMP_DIR}/bin"

cat >"${TMP_DIR}/bin/npm" <<'EOF'
#!/usr/bin/env bash
[[ "${1:-}" == view && "${3:-}" == version ]] || exit 2
case "${2}" in
  @anthropic-ai/claude-code) echo 9.1.0 ;;
  @openai/codex) echo 8.2.0 ;;
  @earendil-works/pi-coding-agent) echo 7.3.0 ;;
  *) exit 2 ;;
esac
EOF
chmod +x "${TMP_DIR}/bin/npm"

write_fixture() {
  cat >"${TMP_DIR}/Dockerfile" <<'EOF'
FROM scratch
ARG CLAUDE_CODE_VERSION=1.0.0
ARG CODEX_VERSION=2.0.0
ARG PI_VERSION=3.0.0
EOF
}

run_update() {
  PATH="${TMP_DIR}/bin:${PATH}" \
    AGENT_SANDBOX_DOCKERFILE="${TMP_DIR}/Dockerfile" \
    AGENT_SANDBOX_SKIP_BUILD=1 \
    "${CONTAINER_DIR}/lib/update-agents" "$@"
}

write_fixture
run_update >/dev/null
rg --fixed-strings --line-regexp 'ARG CLAUDE_CODE_VERSION=9.1.0' "${TMP_DIR}/Dockerfile" >/dev/null
rg --fixed-strings --line-regexp 'ARG CODEX_VERSION=8.2.0' "${TMP_DIR}/Dockerfile" >/dev/null
rg --fixed-strings --line-regexp 'ARG PI_VERSION=7.3.0' "${TMP_DIR}/Dockerfile" >/dev/null

write_fixture
run_update codex >/dev/null
rg --fixed-strings --line-regexp 'ARG CLAUDE_CODE_VERSION=1.0.0' "${TMP_DIR}/Dockerfile" >/dev/null
rg --fixed-strings --line-regexp 'ARG CODEX_VERSION=8.2.0' "${TMP_DIR}/Dockerfile" >/dev/null
rg --fixed-strings --line-regexp 'ARG PI_VERSION=3.0.0' "${TMP_DIR}/Dockerfile" >/dev/null

before=$(shasum "${TMP_DIR}/Dockerfile")
if run_update unknown >/dev/null 2>&1; then
  echo "unknown agent unexpectedly succeeded" >&2
  exit 1
fi
after=$(shasum "${TMP_DIR}/Dockerfile")
[[ "${before}" == "${after}" ]]

printf 'update-agents tests passed\n'
