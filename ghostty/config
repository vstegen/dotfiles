# can use Liga as well
font-family = "PragmataPro Mono"
font-size = 16
theme = Catppuccin Mocha
macos-option-as-alt = left
clipboard-read = ask
clipboard-write = allow
cursor-style = block
fullscreen = false
window-new-tab-position = end
keybind = shift+enter=text:\n
auto-update-channel = "tip"
auto-update = check
